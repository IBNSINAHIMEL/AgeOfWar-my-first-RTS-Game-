[sub_resource type="GDScript" id="GDScript_3dhqy"]
script/source = "# enemy_simple.gd
extends CharacterBody2D

var health = 100
@onready var sprite = $AnimatedSprite2D

func _ready():
	print(\"🎭 Enemy - Health: 100\")
	add_to_group(\"enemy\")
	if sprite:
		sprite.play(\"idle\")
		sprite.modulate = Color.RED

func take_damage(amount):
	print(\"\\n💥 Enemy hit:\", amount, \" damage\")
	health -= amount
	print(\"   Health now:\", health)
	
	if health <= 0:
		print(\"💀 Enemy died!\")
		queue_free()
"

